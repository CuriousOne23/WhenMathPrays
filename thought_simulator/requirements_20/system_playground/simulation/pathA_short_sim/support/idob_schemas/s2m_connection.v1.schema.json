{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2m_connection.v1",
  "title": "S2M connection composition",
  "type": "object",
  "required": ["utterance", "connections", "holes"],
  "additionalProperties": false,
  "properties": {
    "utterance": {"type": "string"},
    "connections": {
      "type": "array",
      "items": {"$ref": "#/$defs/connection"}
    },
    "holes": {
      "type": "array",
      "items": {"$ref": "#/$defs/connection"}
    }
  },
  "$defs": {
    "connection": {
      "type": "object",
      "required": ["left", "relation", "right", "status"],
      "additionalProperties": false,
      "properties": {
        "left": {"type": "string"},
        "relation": {"type": "string"},
        "right": {"type": "string"},
        "status": {"type": "string", "enum": ["supported", "missing"]}
      }
    }
  }
}
