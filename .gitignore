# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/

# VS Code workspace settings (tracked to share interpreter/profile)
# (Do not ignore .vscode so settings.json is shared)

# Test outputs and images
tests/*.png

# Pytest cache
.pytest_cache/

# Ignore system files
.DS_Store
Thumbs.db

# Virtual environments / tools
.venv/
venv/
.python-version

# Environment files (do not commit secrets)
.env
.env.*

# Notebooks & tooling caches
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Coverage and reports
.coverage
coverage.xml
htmlcov/

# Logs
*.log

# IDE folders (keep .vscode tracked; ignore others)
.idea/
.vs/

/logs
