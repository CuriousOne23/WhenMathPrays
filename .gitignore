# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/

# VS Code workspace settings (tracked to share interpreter/profile)
# (Do not ignore .vscode so settings.json is shared)

# Large / generated binaries (see docs/OFFLINE_MEDIA.md)
docs/music/audio/
docs/videos/
docs/Other_papers/
core/revenge_pdf.npz
core/*.backup
results/*.png
tests/revenge/*.png

# Temp / debug scratch
_tmp_*
*_out.txt
output*.txt
debug_output.txt
test_output.txt
*.lnk
file_list.md
thought_simulator/scripts/_*out.txt
thought_simulator/_broken_links.csv

# Test outputs and images
tests/*.png

# Pytest cache
.pytest_cache/

# Ignore system files
.DS_Store
Thumbs.db

# Virtual environments / tools
.venv/
venv/
.python-version

# Environment files (do not commit secrets)
.env
.env.*

# Notebooks & tooling caches
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Coverage and reports
.coverage
coverage.xml
htmlcov/

# Logs (exclude all log files and state viewer logs)
*.log
logs/*.txt
logs/*.log

# IDE folders (keep .vscode tracked; ignore others)
.idea/
.vs/

/logs

# Test benches: only programs and documentation in repo.
# All generated outputs, logs, artifacts, plots, traces, etc. are excluded.
testbenches/**/logs/
testbenches/**/artifacts/
testbenches/**/plots/
testbenches/**/traces/
testbenches/**/*.json
testbenches/**/*.log
testbenches/**/*.png
testbenches/**/*.csv
testbenches/**/results/

# 30.tb/ normalized evidence: only .md records (capsules, deltas) are committed.
# Raw artifacts from test benches are not stored here either.
thought_simulator/30_verification/30.tb/**/*.json
thought_simulator/30_verification/30.tb/**/*.log
thought_simulator/30_verification/30.tb/**/*.png
thought_simulator/30_verification/30.tb/**/artifacts/

# Local full WordNet dump - fetch per wordnet_raw/README.md
**/*.full
thought_simulator/requirements_20/system_playground/design/dictionaries/path_a/conversion_pipeline/wordnet_raw/data.*
thought_simulator/requirements_20/system_playground/design/dictionaries/path_a/conversion_pipeline/wordnet_raw/index.*
thought_simulator/requirements_20/system_playground/design/dictionaries/path_a/conversion_pipeline/wordnet_raw/*.full

# Local full meaning dictionaries - samples may be added later under a different name
thought_simulator/requirements_20/system_playground/design/dictionaries/path_a/meaning_dictionary/**/*.json.gz
thought_simulator/requirements_20/system_playground/design/dictionaries/path_a/runtime_dictionary/**/*.json.gz
thought_simulator/requirements_20/system_playground/design/dictionaries/path_a/**/*.full

# Docs images not kept in GitHub
docs/assets/**
docs/pictures/**
